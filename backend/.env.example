APP_NAME=School365ai
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Each school carries its own timezone (see the schools table), and that is
# what decides dates and times for its data. This one only covers the Super
# Admin's cross-school views, which belong to no single school.
PLATFORM_TIMEZONE=UTC

# Optional. Set before `php artisan down` and the maintenance page says when
# to come back, in PLATFORM_TIMEZONE and US date order. Leave it unset and the
# page says "shortly" instead. See docs/error-pages.md.
# MAINTENANCE_UNTIL="2026-09-15 18:00"


# The first Super Admin, created by `php artisan db:seed` - the only way into
# a freshly deployed instance. There is deliberately no default password: set
# one here before seeding, and change it from the app after first sign-in.
SUPER_ADMIN_EMAIL=super.admin@school365ai.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_MOBILE=

# Where the Flutter web app is served from - used to build links back into
# the frontend (e.g. the password reset link sent by email).
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed browser origins for CORS (Flutter web dev
# server, then the production web domain). "*" is safe only because we use
# Bearer-token auth (supports_credentials=false), never cookie-based auth.
CORS_ALLOWED_ORIGINS=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edutrack
DB_USERNAME=edutrack_user
DB_PASSWORD=

# PostgreSQL, configured alongside MySQL rather than instead of it, so the
# suite can be run against either without editing this file. Its own PG_* keys
# exist for exactly that reason. See docs/python-migration.md.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=edutrack
PG_USERNAME=postgres
PG_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Which SMS adapter delivers messages. "log" is the demo gateway: it records
# the message without calling any third party. See docs/communication.md.
SMS_GATEWAY=log

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Left blank until a phase needs file storage beyond local/cPanel disk
# (see CLAUDE.md rule 25 - architecture stays S3-ready, not S3-required).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
