<?xml version="1.0" encoding="utf-8"?>
<!-- What the launcher's widget gallery shows for the "Today" widget: the
     real layout with a sample child's day (the Family app's copy), so it is not an empty white box. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/today_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
    android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_accent"
        android:textSize="15sp"
        android:textStyle="bold"
        android:text="Aarav" />

    <TextView style="@style/TodayWidgetLine" android:text="Today: Present" />
    <TextView style="@style/TodayWidgetLine" android:text="Bus: Reached school, 7:58 AM" />
    <TextView style="@style/TodayWidgetLine" android:text="Fees: INR 2,500.00 due 11/30/2026" />

    <TextView
    android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FF6B7280"
        android:textSize="11sp"
        android:text="as of 10:40 AM" />
</LinearLayout>
