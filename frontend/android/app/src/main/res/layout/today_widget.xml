<?xml version="1.0" encoding="utf-8"?>
<!-- The "Today" widget (TodayWidgetProvider): a title in the app's accent,
     up to four lines, and when it was true. Lines with nothing to say are
     hidden by the provider, so a short day is a short card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/today_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/today_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView android:id="@+id/today_line1" style="@style/TodayWidgetLine" />
    <TextView android:id="@+id/today_line2" style="@style/TodayWidgetLine" />
    <TextView android:id="@+id/today_line3" style="@style/TodayWidgetLine" />
    <TextView android:id="@+id/today_line4" style="@style/TodayWidgetLine" />

    <TextView
        android:id="@+id/today_as_of"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FF6B7280"
        android:textSize="11sp" />
</LinearLayout>
