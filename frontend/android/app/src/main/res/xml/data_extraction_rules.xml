<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: nothing goes into a cloud backup or a transfer to a
     new phone. allowBackup="false" covers older Android; this covers the rest,
     where device-to-device transfer ignores that flag. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
