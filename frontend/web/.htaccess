# Security headers for the web app (docs/security.md, "The web app").
#
# `flutter build web` copies this file into build/web, and the upload puts it
# in public_html/app/ beside the app's index.html (docs/seo.md, S2). It
# governs everything under /app/; its headers replace the web root's there.
# The API sends its own headers; these are for the page itself, which is what
# a browser runs and an attacker targets.

# Plain HTTP to HTTPS (docs/deployment.md, "The plain-HTTP trap"). Two conditions, both
# required: the host sits behind a proxy (Via: Caddy), so %{HTTPS} alone can
# read 'off' on a secure request and loop forever.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  # The whole path, not a captured part of it: inside /app/ a capture would
  # leave '/app' out of the address.
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Plain addresses (/about, /login, /features) are the web root's job now:
  # its .htaccess is written by `manage.py build_public_site` (docs/seo.md).
</IfModule>

# Anything else that is not a file: our own "page not found", not the host's.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # The app's own files are checked with the server on every load. Without
  # this the server sends no caching rule at all, and a browser guesses from
  # how old a file is - so after a deploy it kept a weeks-old icon font
  # beside the new app, and the sidebar's new Analytics entry showed no
  # icon (2026-10-29). Unchanged files still answer a cheap 304.
  <FilesMatch "\.(html|js|json|otf|ttf|wasm)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # What the page may load and talk to, and nothing else. Each source is here
  # because the app needs it:
  #   'self'                     the app's own files
  #   'wasm-unsafe-eval'         Flutter's renderer is WebAssembly
  #   www.gstatic.com            the renderer itself (CanvasKit) is loaded from there
  #   *.googleapis.com, *.gstatic.com, *.google.com, *.ggpht.com
  #                              Google Maps: its script, tiles, icons and fonts
  #   fonts.gstatic.com / fonts.googleapis.com   the app's typefaces
  #   api.school365ai.com        the API
  #   blob: / data:              files the app builds in the browser (downloads,
  #                              map icons) and Flutter's own workers
  # frame-ancestors 'none' means no other site may show this page in a frame,
  # so a signed-in admin cannot be tricked into clicking through an invisible
  # copy of it (clickjacking).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.gstatic.com https://maps.googleapis.com https://*.googleapis.com https://*.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.ggpht.com https://*.googleusercontent.com; connect-src 'self' https://api.school365ai.com https://www.gstatic.com https://fonts.gstatic.com https://fonts.googleapis.com https://*.googleapis.com https://*.gstatic.com https://*.google.com data: blob:; worker-src 'self' blob:; frame-src https://*.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

  # The same refusal for browsers too old to read frame-ancestors.
  Header always set X-Frame-Options "DENY"

  # A file is what its type says it is, never sniffed into a script.
  Header always set X-Content-Type-Options "nosniff"

  # Links out of the app do not carry the page address (which, on the
  # set-password page, includes the one-time link).
  Header always set Referrer-Policy "no-referrer"

  # Location, camera and microphone are used only by the phone apps; the web
  # build has no code that asks for them, so nothing on the page may.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>
